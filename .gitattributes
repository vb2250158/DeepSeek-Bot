# Shell scripts are copied into the Docker image as they are; CRLF breaks them.
*.sh text eol=lf

# Cookie fixtures test BOM and line-ending variants; normalizing them removes what they test.
app/test/fixtures/** -text -whitespace

# Generated JavaScript includes the thin client template verbatim.
ds-bot/scripts/thin-client.js text eol=lf
ds-bot/client-app.js text eol=lf
